{% comment %}
  Trust bar: short reasons to buy, shown under the home hero.
{% endcomment %}

{% render 'gypsey-brand' %}

{% style %}
  .gypsey-trust-bar {
    background: var(--gr-blush);
    border-bottom: 0.1rem solid var(--gr-line);
  }

  .gypsey-trust-bar__list {
    display: grid;
    gap: 1.2rem 2.4rem;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding-block: 1.8rem;
  }

  .gypsey-trust-bar__item {
    align-items: center;
    color: var(--gr-body);
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    min-width: 0;
  }

  .gypsey-trust-bar__item a {
    color: inherit;
    text-decoration: none;
  }

  .gypsey-trust-bar__item a:hover .gypsey-trust-bar__title {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .gypsey-trust-bar__icon {
    align-items: center;
    background: var(--gr-white);
    border-radius: 50%;
    color: var(--gr-pink-deep);
    display: flex;
    flex: 0 0 auto;
    height: 3.8rem;
    justify-content: center;
    width: 3.8rem;
  }

  .gypsey-trust-bar__icon svg {
    height: 2rem;
    width: 2rem;
  }

  .gypsey-trust-bar__title {
    display: block;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .gypsey-trust-bar__text {
    color: var(--gr-body-soft);
    display: block;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .gypsey-trust-bar__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gypsey-trust-bar__item {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 479px) {
    .gypsey-trust-bar__icon {
      height: 3.2rem;
      width: 3.2rem;
    }

    .gypsey-trust-bar__title {
      font-size: 1.3rem;
    }

    .gypsey-trust-bar__text {
      display: none;
    }
  }
{% endstyle %}

<section class="gr-section gypsey-trust-bar" aria-label="Why shop with Gypsey Rose">
  <ul class="gypsey-trust-bar__list page-width" role="list">
    {%- for block in section.blocks -%}
      <li class="gypsey-trust-bar__item" {{ block.shopify_attributes }}>
        <span class="gypsey-trust-bar__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7M7.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6"/></svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Zm0 0 7-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
            {%- when 'return' -%}
              <svg viewBox="0 0 24 24"><path d="M9 7 5 11l4 4M5 11h10a4 4 0 0 1 0 8h-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24"><path d="M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6"/></svg>
          {%- endcase -%}
        </span>
        {%- capture item_copy -%}
          <span>
            <span class="gypsey-trust-bar__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="gypsey-trust-bar__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        {%- endcapture -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ item_copy }}</a>
        {%- else -%}
          {{ item_copy }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Gypsey trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Reason to buy",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "leaf", "label": "Natural cotton" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure checkout" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Reason to buy"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gypsey trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free shipping" } },
        { "type": "item", "settings": { "icon": "leaf", "title": "100% cotton" } },
        { "type": "item", "settings": { "icon": "return", "title": "Easy returns" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
