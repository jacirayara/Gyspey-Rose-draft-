{% liquid
  assign slide_count = section.blocks.size
  assign rotation_ms = section.settings.rotation_seconds | times: 1000
%}

{% style %}
#GypseyHero-{{ section.id }}{--hero-accent:#ec369f;--hero-green:#164f35;background:#173f2d;color:#fff;position:relative;overflow:hidden}
#GypseyHero-{{ section.id }} .gypsey-hero__viewport{display:grid;grid-template-columns:minmax(0,1fr);position:relative;min-width:0}
#GypseyHero-{{ section.id }} .gypsey-hero__slide{display:none;grid-area:1/1;grid-template-columns:1fr 1fr;min-width:0;margin:0}
#GypseyHero-{{ section.id }} .gypsey-hero__slide.is-active{display:grid}
#GypseyHero-{{ section.id }} .gypsey-hero__image{grid-column:2;grid-row:1;width:100%;height:520px;object-fit:contain;object-position:center;display:block}
#GypseyHero-{{ section.id }} .gypsey-hero__veil{grid-column:1;grid-row:1;display:flex;align-items:center;min-width:0}
#GypseyHero-{{ section.id }} .gypsey-hero__content{width:100%;box-sizing:border-box;padding:44px 64px}
#GypseyHero-{{ section.id }} .gypsey-hero__eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;margin:0 0 16px}
#GypseyHero-{{ section.id }} .gypsey-hero__heading{color:inherit;font-size:clamp(34px,3.8vw,54px);line-height:1.08;letter-spacing:-.03em;margin:0;text-wrap:balance}
#GypseyHero-{{ section.id }} .gypsey-hero__text{font-size:17px;line-height:1.6;margin:20px 0 0;max-width:38em}
#GypseyHero-{{ section.id }} .gypsey-hero__button{display:inline-flex;align-items:center;justify-content:center;background:#ec369f;color:#fff;text-decoration:none;border-radius:4px;min-height:48px;padding:12px 24px;font-size:15px;font-weight:700;margin-top:24px}
#GypseyHero-{{ section.id }} .gypsey-hero__arrow{position:absolute;top:45%;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#fff;color:#164f35;display:grid;place-items:center;cursor:pointer}
#GypseyHero-{{ section.id }} .gypsey-hero__arrow--previous{left:12px}#GypseyHero-{{ section.id }} .gypsey-hero__arrow--next{right:12px}
#GypseyHero-{{ section.id }} .gypsey-hero__arrow svg{width:18px;height:18px}
#GypseyHero-{{ section.id }} .gypsey-hero__dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:10px;z-index:2}
#GypseyHero-{{ section.id }} .gypsey-hero__dot{width:9px;height:9px;border:0;padding:0;border-radius:20px;background:#ffffff88;cursor:pointer}
#GypseyHero-{{ section.id }} .gypsey-hero__dot.is-active{width:28px;background:#fff}
@media(max-width:749px){#GypseyHero-{{ section.id }} .gypsey-hero__slide.is-active{display:flex;flex-direction:column}#GypseyHero-{{ section.id }} .gypsey-hero__image{height:260px;object-fit:contain}#GypseyHero-{{ section.id }} .gypsey-hero__content{padding:24px 28px 48px;text-align:center}#GypseyHero-{{ section.id }} .gypsey-hero__heading{font-size:32px}#GypseyHero-{{ section.id }} .gypsey-hero__text{font-size:16px;margin-top:14px}#GypseyHero-{{ section.id }} .gypsey-hero__button{margin-top:18px}#GypseyHero-{{ section.id }} .gypsey-hero__arrow{top:120px}}
.gr-new-arrivals{padding:42px 24px}.gr-new-arrivals__top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.gr-new-arrivals h2{font-size:32px;margin:0;color:#164f35}.gr-new-arrivals__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}.gr-new-arrivals__card{color:#173f2d;text-decoration:none;display:block}.gr-new-arrivals__card img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:6px}.gr-new-arrivals__card h3{font-family:inherit;font-size:15px;line-height:1.4;margin:12px 0 6px}.gr-new-arrivals__card p{margin:0;font-size:15px}.gr-new-arrivals__top a{color:#164f35;font-size:15px}@media(max-width:989px){.gr-new-arrivals__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:749px){.gr-new-arrivals{padding:28px 20px}.gr-new-arrivals h2{font-size:27px}.gr-new-arrivals__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 12px}}
{% endstyle %}

<section
  id="GypseyHero-{{ section.id }}"
  class="gypsey-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  data-rotation="{{ rotation_ms }}"
  aria-roledescription="carousel"
  aria-label="Gypsey Rose seasonal highlights"
>
  <div class="gypsey-hero__viewport" aria-live="off">
    {% for block in section.blocks %}
      {% liquid
        if forloop.first
          assign heading_tag = 'h1'
          assign image_loading = 'eager'
          assign image_priority = 'high'
        else
          assign heading_tag = 'h2'
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
        endif
      %}
      <article
        class="gypsey-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        aria-label="Slide {{ forloop.index }} of {{ slide_count }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag:
              class: 'gypsey-hero__image',
              widths: '750, 1100, 1500, 2000',
              sizes: '100vw',
              loading: image_loading,
              fetchpriority: image_priority,
              alt: block.settings.alt
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gypsey-hero__placeholder' }}
        {% endif %}

        <div class="gypsey-hero__veil">
          <div class="gypsey-hero__content">
            <div class="gypsey-hero__copy">
              {% if block.settings.badge != blank %}
                <span class="gypsey-hero__badge">{{ block.settings.badge }}</span>
              {% endif %}
              {% if block.settings.eyebrow != blank %}
                <p class="gypsey-hero__eyebrow">{{ block.settings.eyebrow }}</p>
              {% endif %}
              <{{ heading_tag }} class="gypsey-hero__heading">{{ block.settings.heading }}</{{ heading_tag }}>
              {% if block.settings.text != blank %}
                <p class="gypsey-hero__text">{{ block.settings.text }}</p>
              {% endif %}
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                <a class="gypsey-hero__button" href="{{ block.settings.button_link }}">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </article>
    {% endfor %}

    {% if slide_count > 1 %}
      <button class="gypsey-hero__arrow gypsey-hero__arrow--previous" type="button" data-previous aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 19-7-7 7-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
      </button>
      <button class="gypsey-hero__arrow gypsey-hero__arrow--next" type="button" data-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
      </button>

      <div class="gypsey-hero__dots" role="tablist" aria-label="Choose a slide">
        {% for block in section.blocks %}
          <button
            class="gypsey-hero__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-dot="{{ forloop.index0 }}"
            aria-label="Show slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
<section class="gr-new-arrivals page-width" aria-labelledby="gr-arrivals-title"><div class="gr-new-arrivals__top"><h2 id="gr-arrivals-title">New Arrivals</h2><a href="/collections/all?sort_by=created-descending">View all new arrivals</a></div><div class="gr-new-arrivals__grid">{% assign arrival_handles = 'kimmie-cropped-emerald-green-stand-tall,kimmie-cropped-off-white-fly-high,kimmie-cropped-bright-orange-be-kind,kimmie-cropped-bright-pink-monkey-mind,bird-dress-white-background-with-bold-and-bright-pink-and-red-proteas-and-turquoise-leaves,bird-dress-bright-coral-base-with-bold-white-cream-tropical-print-featuing-stylized-pineapple-peacocks-and-palm-fronds' | split: ',' %}{% for handle in arrival_handles %}{% assign arrival = all_products[handle] %}{% if arrival != blank and arrival.available %}<a class="gr-new-arrivals__card" href="{{ arrival.url }}">{{ arrival.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', sizes: '(max-width:749px) 45vw, 16vw', alt: arrival.title }}<h3>{{ arrival.title | escape }}</h3><p>{% if arrival.price_varies %}From {% endif %}{{ arrival.price | money }}</p></a>{% endif %}{% endfor %}</div></section>


<script>
  (() => {
    const root = document.getElementById('GypseyHero-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;

    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const previous = root.querySelector('[data-previous]');
    const next = root.querySelector('[data-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplay = root.dataset.autoplay === 'true' && !reduceMotion && slides.length > 1;
    const rotation = Number(root.dataset.rotation) || 5500;
    let activeIndex = 0;
    let timer;
    let touchStartX = 0;

    const showSlide = (newIndex, resetTimer = true) => {
      activeIndex = (newIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });
      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });
      if (resetTimer) startAutoplay();
    };

    const stopAutoplay = () => window.clearInterval(timer);
    const startAutoplay = () => {
      stopAutoplay();
      if (autoplay) timer = window.setInterval(() => showSlide(activeIndex + 1, false), rotation);
    };

    previous?.addEventListener('click', () => showSlide(activeIndex - 1));
    next?.addEventListener('click', () => showSlide(activeIndex + 1));
    dots.forEach((dot) => dot.addEventListener('click', () => showSlide(Number(dot.dataset.dot))));
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);
    root.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0].clientX;
    }, { passive: true });
    root.addEventListener('touchend', (event) => {
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 50) showSlide(activeIndex + (distance < 0 ? 1 : -1));
    }, { passive: true });
    document.addEventListener('shopify:block:select', (event) => {
      const selectedSlide = event.target.closest('[data-slide]');
      if (selectedSlide && root.contains(selectedSlide)) showSlide(slides.indexOf(selectedSlide));
    });

    root.dataset.ready = 'true';
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Gypsey seasonal carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_seconds",
      "min": 4,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "label": "Time per slide",
      "default": 5.5
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Campaign slide",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text",
          "default": "Gypsey Rose cotton clothing"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "100% pure cotton"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Cotton made joyful"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Breathable cotton clothing made for colourful days."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gypsey seasonal carousel",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
