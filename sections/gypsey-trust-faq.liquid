{% render 'gypsey-brand' %}

{% style %}
  .gypsey-trust-faq {
    background: var(--gr-blush);
    border-block: 0.1rem solid var(--gr-line);
  }

  .gypsey-trust-faq .page-width {
    padding-block: clamp(3.6rem, 6vw, 6.4rem);
  }

  .gypsey-trust-faq__intro {
    max-width: 72rem;
  }

  .gypsey-trust-faq__intro h2 {
    font-size: clamp(2.8rem, 4vw, 4.6rem);
    line-height: 1.06;
    margin: 0;
  }

  .gypsey-trust-faq__intro p {
    color: var(--gr-body-soft);
    font-size: 1.7rem;
    line-height: 1.6;
    margin-top: 1.4rem;
  }

  .gypsey-trust-faq__signals {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 2.8rem 0;
  }

  .gypsey-trust-faq__signals span {
    align-items: center;
    background: var(--gr-white);
    border: 0.1rem solid var(--gr-line);
    border-radius: var(--gr-radius);
    color: var(--gr-pink-deep);
    display: flex;
    font-weight: 700;
    font-size: 1.4rem;
    min-height: 7rem;
    padding: 1.4rem 1.8rem;
  }

  .gypsey-trust-faq__questions {
    display: grid;
    gap: 0.8rem;
    max-width: 82rem;
  }

  .gypsey-trust-faq__questions details {
    background: var(--gr-white);
    border: 0.1rem solid var(--gr-line);
    border-radius: var(--gr-radius);
    overflow: hidden;
  }

  .gypsey-trust-faq__questions summary {
    align-items: center;
    color: var(--gr-pink-deep);
    cursor: pointer;
    display: flex;
    font-family: var(--gr-serif);
    font-size: 1.9rem;
    font-weight: 500;
    justify-content: space-between;
    list-style: none;
    padding: 1.8rem 2rem;
  }

  .gypsey-trust-faq__questions summary::-webkit-details-marker {
    display: none;
  }

  .gypsey-trust-faq__questions summary::after {
    color: var(--gr-lavender);
    content: "+";
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .gypsey-trust-faq__questions details[open] summary::after {
    transform: rotate(45deg);
  }

  .gypsey-trust-faq__questions p {
    color: var(--gr-body-soft);
    font-size: 1.6rem;
    line-height: 1.62;
    margin: 0;
    padding: 0 2rem 2rem;
  }

  @media screen and (max-width: 749px) {
    .gypsey-trust-faq__signals {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstyle %}

<section class="gr-section gypsey-trust-faq" aria-labelledby="gypsey-faq-title">
  <div class="page-width">
    <div class="gypsey-trust-faq__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="gr-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="gypsey-faq-title">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="gypsey-trust-faq__signals" aria-label="Store trust signals">
      {% if section.settings.signal_1 != blank %}<span>{{ section.settings.signal_1 | escape }}</span>{% endif %}
      {% if section.settings.signal_2 != blank %}<span>{{ section.settings.signal_2 | escape }}</span>{% endif %}
      {% if section.settings.signal_3 != blank %}<span>{{ section.settings.signal_3 | escape }}</span>{% endif %}
      {% if section.settings.signal_4 != blank %}<span>{{ section.settings.signal_4 | escape }}</span>{% endif %}
    </div>

    <div class="gypsey-trust-faq__questions">
      {% for i in (1..8) %}
        {% assign question_key = 'question_' | append: i %}
        {% assign answer_key = 'answer_' | append: i %}
        {% if section.settings[question_key] != blank %}
          <details{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ section.settings[question_key] | escape }}</summary>
            <p>{{ section.settings[answer_key] | escape | newline_to_br }}</p>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

